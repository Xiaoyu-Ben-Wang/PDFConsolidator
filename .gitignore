# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Vendored dependencies (regenerate with tools/vendor.py) ----
vendor/
_probe/vendor/
_probe/vendor2/
_probe/*.whl
_probe/tmp/
_probe/simulated-target/
_probe/**/build/
_probe/**/dist/
_probe/**/_dist/
_probe/**/*.x/

# ---- PyInstaller ----
build/
dist/
*.spec

# ---- Test / scratch output ----
out/
fixtures/out/
fixtures/generated/
fixtures/email/
fixtures/msg/
*.pdf.tmp

# Vendored dependency cache (regenerate with tools/vendor.py)
.vendor-cache/
vendor/

# Scratch directories. The system temp directory can be missing or unwritable,
# in which case Python, pip and pytest fall back to the working directory and
# leave these behind.
.consolidator-scratch/
pdfconsolidator/
pytest-of-*/
pip-metadata-*/
pip-unpack-*/
pip-install-*/
pip-build-*/
pip-target-*/
ab_*/
dbg_lo_*/
consolidator_*/
tmp*/
run_*/

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
