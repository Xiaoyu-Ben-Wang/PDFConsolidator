# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Vendored dependencies (regenerate with tools/vendor.py) ----
vendor/
_probe/vendor/
_probe/vendor2/
_probe/*.whl
_probe/tmp/
_probe/simulated-target/
_probe/**/build/
_probe/**/dist/
_probe/**/_dist/
_probe/**/*.x/

# ---- PyInstaller ----
# Only PyInstaller's own output is ignored. build/ also holds the frozen entry
# point and the Windows version resource, which are source and must be tracked -
# a blanket "build/" made a fresh clone unable to produce the bundle at all.
build/_work/
dist/
*.spec

# ---- Test / scratch output ----
out/
fixtures/out/
fixtures/generated/
fixtures/email/
fixtures/msg/
*.pdf.tmp

# Vendored dependency cache (regenerate with tools/vendor.py)
.vendor-cache/
vendor/

# Scratch directories. The application creates its own rather than trusting the
# system temp directory, which can be missing or unwritable.
.scratch/
.consolidator-scratch/
.pytest-tmp/
pytest-tmp/
lo-profiles/
pdfconsolidator/
pytest-of-*/
pip-metadata-*/
pip-unpack-*/
pip-install-*/
pip-build-*/
pip-target-*/
ab_*/
dbg_lo_*/
consolidator_*/
tmp*/
run_*/
selftest_*/
selftest.log
startup-error.log
consolidator-errors.log

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- Working notes and experiments (kept locally, not published) ----
PLAN.md
RESEARCH-*.md
CLAUDE.md
.claude/
_probe/
tools/make_msg_fixtures.py
